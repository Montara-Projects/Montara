{
  "version": 2,
  "rewrites": [
    {
      "source": "/editor/",
      "destination": "/editor/index.html"
    },
    {
      "source": "/planes/",
      "destination": "/planes/index.html"
    },
    {
      "source": "/anuncios/",
      "destination": "/anuncios/index.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "outputDirectory": "public"
}
