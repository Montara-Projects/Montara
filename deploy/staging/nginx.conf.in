# Render for a dedicated staging hostname and certificate only.
# The portal must listen on loopback, on a different port from the status page.
server {
    listen 443 ssl;
    server_name @BACKEND_HOST@;
    ssl_certificate @CERTIFICATE@;
    ssl_certificate_key @CERTIFICATE_KEY@;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Existing uploader streams bounded chunks. Keep legacy direct requests
    # inside the Owner portal's own, narrower admission limits.
    client_max_body_size 256m;

    location / {
        proxy_pass http://127.0.0.1:8127;
        proxy_http_version 1.1;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 180s;

        # The application verifies the exact host and loopback peer itself.
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Proto "";
        proxy_set_header X-Forwarded-Port "";
        proxy_set_header X-Real-IP "";
        proxy_set_header Forwarded "";
        proxy_set_header Connection "";
    }
}
